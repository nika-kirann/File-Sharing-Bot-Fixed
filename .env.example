# Copy to .env for local runs. On Koyeb, set these in the service settings.
# Never commit a filled-in .env file.
# Booleans accept true/false, 1/0, yes/no, on/off. The word False is false.

# Required. Bot token from @BotFather.
TG_BOT_TOKEN=

# Required. Numeric API ID from https://my.telegram.org
APP_ID=

# Required. API hash from https://my.telegram.org
API_HASH=

# Required. Database channel id, for example -1001234567890.
# A positive id copied from t.me/c/<id> is accepted and prefixed with -100.
CHANNEL_ID=

# Required. Your numeric Telegram user id. This user is always an admin.
OWNER_ID=

# Required. MongoDB URI starting with mongodb:// or mongodb+srv://
DATABASE_URL=

# Optional. MongoDB database name.
DATABASE_NAME=filesharingbot

# Optional. HTTP health-check port. Koyeb sets PORT for web services.
PORT=8080

# Optional. Pyrogram worker threads (minimum 1).
TG_BOT_WORKERS=4

# Optional. Extra admin user ids, separated by spaces or commas.
ADMINS=

# Optional. Channel or group id, or @username, that users must join. 0 disables it.
FORCE_SUB_CHANNEL=0

# Optional. When true, submitting a join request counts as joined. Needs FORCE_SUB_CHANNEL.
JOIN_REQUEST_ENABLED=False

# Optional. HTML /start text. Placeholders: {first} {last} {id} {mention} {username}
START_MESSAGE=Hello {first}

# Optional. Public image URL for /start. Empty sends text only.
START_PIC=

# Optional. Shown when force-subscribe is not satisfied. Same placeholders as START_MESSAGE.
FORCE_SUB_MESSAGE=Hello {first}

# Optional. Caption used for documents. Placeholders: {filename} {previouscaption}
CUSTOM_CAPTION=

# Optional. true stops users from forwarding shared files.
PROTECT_CONTENT=False

# Optional. Seconds before a delivered file is deleted. 0 disables auto-delete.
AUTO_DELETE_TIME=0

# Optional. Shown with the file. {time} is the delay in seconds.
AUTO_DELETE_MSG=This file will be automatically deleted in {time} seconds.

# Optional. Shown after the file is deleted.
AUTO_DEL_SUCCESS_MSG=Your file has been deleted.

# Optional. true does not add the Share URL button on database-channel posts.
DISABLE_CHANNEL_BUTTON=False

# Optional. /stats text. {uptime} is the process uptime.
BOT_STATS_TEXT="<b>BOT UPTIME</b>\n{uptime}"

# Optional. Reply when a non-admin sends an ordinary message.
USER_REPLY_TEXT=I only share files through links. Use a file link, or send /start.

# Optional. Rotating log path, or none to log only to stdout.
LOG_FILE=filesharingbot.txt
